<?php
    class Person {
        public $name;
        public $age;
        
        public function __construct($name, $age) {
            $this->name = $name;
            $this->age = $age;
            echo "Tworze człowieka ma na imię $name i ma $age lat.\n";
        }
    }    

$person = new Person("Marek", 20);
echo $person->name;
?>
